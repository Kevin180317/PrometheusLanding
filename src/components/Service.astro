---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    name: t("service.name1"), desc: t("service.desc1"), tag: t("service.tag1"),
    icon: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M7 8h2M11 8h6M7 11h4M13 11h4"/>`,
  },
  {
    name: t("service.name2"), desc: t("service.desc2"), tag: t("service.tag2"),
    icon: `<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h1M14 9h1M9 14h1M14 14h1M12 9v6M9 12h6"/>`,
  },
  {
    name: t("service.name3"), desc: t("service.desc3"), tag: t("service.tag3"),
    icon: `<rect x="7" y="7" width="10" height="10" rx="1"/><path d="M7 10H4M7 14H4M17 10h3M17 14h3M10 7V4M14 7V4M10 17v3M14 17v3"/>`,
  },
  {
    name: t("service.name4"), desc: t("service.desc4"), tag: t("service.tag4"),
    icon: `<path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>`,
  },
];
---

<section id="services" class="px-12 py-20 bg-dark-2 max-md:px-5 max-md:py-12">
  <div class="flex items-center gap-3 mb-3">
    <span class="inline-block w-6 h-[1px] bg-cyan"></span>
    <span class="text-[10px] tracking-[5px] uppercase text-cyan">{t("section.eyebrow.services")}</span>
  </div>
  <h2 class="font-bebas text-[clamp(40px,5vw,52px)] tracking-[3px] mb-3 leading-none">{t("section.title.services")}</h2>
  <p class="text-[15px] font-light text-gray-custom max-w-[560px] leading-[1.8] mb-10">{t("section.sub.services")}</p>

  <div class="grid grid-cols-2 max-md:grid-cols-1 gap-[1px] bg-cyan/10 border border-cyan/10">
    {services.map((s) => (
      <div class="bg-dark-3 p-9 pl-7 relative group transition-colors hover:bg-[#1a2535] max-md:p-6">
        <div class="absolute top-0 left-0 w-[3px] h-0 bg-cyan transition-all duration-[350ms] group-hover:h-full"></div>
        <div class="w-11 h-11 bg-[rgba(57,186,200,0.08)] border border-cyan/20 flex items-center justify-center mb-5">
          <svg class="w-5 h-5 stroke-cyan fill-none stroke-[1.5]" viewBox="0 0 24 24" set:html={s.icon} />
        </div>
        <div class="font-bebas text-[22px] tracking-[2px] mb-[10px]">{s.name}</div>
        <div class="text-[13px] font-light text-gray-custom leading-[1.7] mb-[18px]">{s.desc}</div>
        <span class="text-[10px] tracking-[1.5px] uppercase text-cyan border border-cyan/30 px-3 py-1 inline-block">{s.tag}</span>
      </div>
    ))}
  </div>
</section>
