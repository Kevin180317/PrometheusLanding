---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const prefix = lang === "en" ? "/en" : "";
const home = prefix + "/";
const servicesHref = prefix + "/services";
const aboutHref = prefix + "/about";
const contactHref = prefix + "/contact";
const terminosHref = prefix + "/terminos";
const privacidadHref = prefix + "/privacidad";
---

<footer class="bg-[#07090C] px-12 py-14 pt-8 border-t border-cyan/15 max-md:px-5 max-md:py-10">
  <div class="grid grid-cols-[2.5fr_1fr_1fr_1fr] gap-10 mb-10 max-md:grid-cols-2 max-sm:grid-cols-1">
    <div>
      <a href={home} class="no-underline block mb-3">
        <img src="/logo-oficial.png" alt="Prometheus" class="h-12 w-auto" />
      </a>
      <div class="text-[12px] italic text-gray-custom font-light leading-[1.7] mb-4">{t("footer.tagline")}</div>
      <div class="text-[10px] text-gray-custom2 tracking-[2px]">{t("footer.location")}</div>
    </div>
    <div>
      <div class="text-[9px] tracking-[3px] uppercase text-cyan mb-4">{t("footer.col1")}</div>
      <a href={servicesHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link1")}</a>
      <a href={servicesHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link2")}</a>
      <a href={servicesHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link3")}</a>
      <a href={servicesHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link4")}</a>
    </div>
    <div>
      <div class="text-[9px] tracking-[3px] uppercase text-cyan mb-4">{t("footer.col2")}</div>
      <a href={aboutHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link5")}</a>
      <a href={contactHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link8")}</a>
    </div>
    <div>
      <div class="text-[9px] tracking-[3px] uppercase text-cyan mb-4">{t("footer.col3")}</div>
      <a href={terminosHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link9")}</a>
      <a href={privacidadHref} class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link10")}</a>
    </div>
  </div>
  <div class="border-t border-[rgba(57,186,200,0.08)] pt-5 flex justify-between items-center max-sm:flex-col max-sm:gap-3">
    <div class="text-[10px] text-gray-custom2 tracking-[1.5px]">© {year} {t("footer.copy")}</div>
    <div class="flex gap-[10px]">
      <a href="https://www.instagram.com/prometheusarttij/" target="_blank" rel="noopener" aria-label="Instagram" class="w-8 h-8 border border-cyan/20 flex items-center justify-center text-gray-custom no-underline hover:border-cyan hover:text-cyan transition-all">
        <svg class="w-[14px] h-[14px] fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </a>
      <a href="https://www.facebook.com/profile.php?id=61555674795492" target="_blank" rel="noopener" aria-label="Facebook" class="w-8 h-8 border border-cyan/20 flex items-center justify-center text-gray-custom no-underline hover:border-cyan hover:text-cyan transition-all">
        <svg class="w-[14px] h-[14px] fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://x.com/PrometheusTij" target="_blank" rel="noopener" aria-label="X (Twitter)" class="w-8 h-8 border border-cyan/20 flex items-center justify-center text-gray-custom no-underline hover:border-cyan hover:text-cyan transition-all">
        <svg class="w-[14px] h-[14px] fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>
  </div>
</footer>
