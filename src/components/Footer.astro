---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[#07090C] px-12 py-14 pt-8 border-t border-cyan/15 max-md:px-5 max-md:py-10">
  <div class="grid grid-cols-[2.5fr_1fr_1fr_1fr] gap-10 mb-10 max-md:grid-cols-2 max-sm:grid-cols-1">
    <div>
      <div class="font-bebas text-[22px] tracking-[4px] mb-3">PROMET<span class="text-cyan">H</span>EUS</div>
      <div class="text-[12px] italic text-gray-custom font-light leading-[1.7] mb-4">{t("footer.tagline")}</div>
      <div class="text-[10px] text-gray-custom2 tracking-[2px]">{t("footer.location")}</div>
    </div>
    <div>
      <div class="text-[9px] tracking-[3px] uppercase text-cyan mb-4">{t("footer.col1")}</div>
      <a href="#services" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link1")}</a>
      <a href="#services" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link2")}</a>
      <a href="#services" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link3")}</a>
      <a href="#services" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link4")}</a>
    </div>
    <div>
      <div class="text-[9px] tracking-[3px] uppercase text-cyan mb-4">{t("footer.col2")}</div>
      <a href="#about" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link5")}</a>
      <a href="#portfolio" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link6")}</a>
      <a href="#" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link7")}</a>
      <a href="#contact" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link8")}</a>
    </div>
    <div>
      <div class="text-[9px] tracking-[3px] uppercase text-cyan mb-4">{t("footer.col3")}</div>
      <a href="#" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link9")}</a>
      <a href="#" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link10")}</a>
      <a href="#" class="block text-[12px] text-gray-custom no-underline mb-2 hover:text-white transition-colors">{t("footer.link11")}</a>
    </div>
  </div>
  <div class="border-t border-[rgba(57,186,200,0.08)] pt-5 flex justify-between items-center max-sm:flex-col max-sm:gap-3">
    <div class="text-[10px] text-gray-custom2 tracking-[1.5px]">© {year} {t("footer.copy")}</div>
    <div class="flex gap-[10px]">
      <a href="#" target="_blank" class="w-8 h-8 border border-cyan/20 flex items-center justify-center text-[10px] font-semibold text-gray-custom no-underline hover:border-cyan hover:text-cyan transition-all">in</a>
      <a href="#" target="_blank" class="w-8 h-8 border border-cyan/20 flex items-center justify-center text-[10px] font-semibold text-gray-custom no-underline hover:border-cyan hover:text-cyan transition-all">ig</a>
      <a href="#" target="_blank" class="w-8 h-8 border border-cyan/20 flex items-center justify-center text-[10px] font-semibold text-gray-custom no-underline hover:border-cyan hover:text-cyan transition-all">fb</a>
    </div>
  </div>
</footer>
