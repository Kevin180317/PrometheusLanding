---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="bg-cyan flex items-center justify-between px-8 py-[10px] max-md:px-5">
  <span class="text-[12px] font-semibold text-dark tracking-[1px]">{t("banner.text")}</span>
  <a href="#contact" class="text-[14px] font-semibold text-dark tracking-[2px] uppercase underline cursor-pointer">{t("banner.cta")}</a>
</div>
