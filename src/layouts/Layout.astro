---
import { ClientRouter } from "astro:transitions";
import Banner from "@Components/Banner.astro";
import Header from "@Components/Header.astro";
import Footer from "@Components/Footer.astro";
import FloatingWhatsApp from "@Components/FloatingWhatsApp.astro";
import { getLangFromUrl } from "src/i18n/utils";

interface Props {
  title: string;
  description: string;
  keywords: string;
}

const { title, description, keywords } = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Logo2.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={Astro.url} />
    <meta name="description" content={description} />
    <meta name="author" content="PrometheusTij" />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="publisher" content="PrometheusTij" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://prometheustij.com/ogImage.jpg" />
    <meta property="og:url" content="https://prometheustij.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="https://prometheustij.com/" />
    <meta
      name="google-site-verification"
      content="GExUNFmJDSMw7Nb_yoabt-80oVorKEkOcGO2eQ_4aHg"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,300;0,400;0,600;1,300&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Theme init: runs before paint to avoid flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme') || 'system';
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (stored === 'system' && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        document.documentElement.setAttribute('data-theme', stored);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="overflow-x-hidden bg-dark text-themed font-barlow">
    <Banner />
    <Header />
    <slot />
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>

<style is:global>
  :root {
    --bg: 255 255 255;
    --bg-2: 245 247 250;
    --bg-3: 234 236 239;
    --text-primary: 0 0 0;
    --text-muted: 85 85 85;
    --text-muted2: 136 136 136;
  }
  .dark {
    --bg: 13 17 23;
    --bg-2: 17 24 32;
    --bg-3: 22 30 39;
    --text-primary: 255 255 255;
    --text-muted: 175 175 175;
    --text-muted2: 102 102 102;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
