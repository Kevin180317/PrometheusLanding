---
import { ClientRouter } from "astro:transitions";
import Banner from "@Components/Banner.astro";
import Header from "@Components/Header.astro";
import Footer from "@Components/Footer.astro";
import FloatingWhatsApp from "@Components/FloatingWhatsApp.astro";
import { getLangFromUrl } from "src/i18n/utils";

interface Props {
  title: string;
  description: string;
  keywords: string;
}

const { title, description, keywords } = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Logo2.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={Astro.url} />
    <meta name="description" content={description} />
    <meta name="author" content="PrometheusTij" />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="publisher" content="PrometheusTij" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://prometheustij.com/ogImage.jpg" />
    <meta property="og:url" content="https://prometheustij.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="https://prometheustij.com/" />
    <meta
      name="google-site-verification"
      content="GExUNFmJDSMw7Nb_yoabt-80oVorKEkOcGO2eQ_4aHg"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,300;0,400;0,600;1,300&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="overflow-x-hidden bg-dark text-white font-barlow">
    <Banner />
    <Header />
    <slot />
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
</style>
