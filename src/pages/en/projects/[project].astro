    },
    {
      id: 5,
      name: "Portfolio Photography John",
      description:
        "Professional photography portfolio with dynamic gallery, image optimization and minimalist design that highlights the artist's work.",
      category: "Web",
      tags: ["Photography", "Portfolio", "Art"],
