      description:
        "Online store specialized in medical and health products. Advanced search system, shopping cart and inventory management.",
      category: "Web",
      tags: ["E-commerce", "Healthcare", "B2C"],
      year: "2023",
      images: ["/Imagenes/mockup2.png"],
      projectUrl: "https://medical-commerce.netlify.app/",
