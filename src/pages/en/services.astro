---
import Layout from "@Layouts/Layout.astro";
import ServicesPortfolio from "@Components/ServicesPortfolio";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const params = new URLSearchParams(Astro.url.search);
const filtro = params.get("filtro") || "";
---

<Layout
  title="Services | Prometheus R&D"
  description="Software, AI Automation and Digital Electronics — custom solutions in Tijuana."
  keywords="services, software development, AI, electronics, Tijuana"
>
  <!-- Hero -->
  <section class="relative px-12 py-24 overflow-hidden bg-dark max-md:px-5 max-md:py-16">
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(57,186,200,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(57,186,200,0.04) 1px, transparent 1px); background-size: 48px 48px;"></div>
    <div class="absolute top-[-140px] right-[-140px] w-[600px] h-[600px] pointer-events-none" style="background: radial-gradient(circle, rgba(57,186,200,0.1) 0%, transparent 65%);"></div>

    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-block w-9 h-[2px] bg-cyan"></span>
        <span class="text-[14px] tracking-[5px] uppercase text-cyan">{t("section.eyebrow.services")}</span>
      </div>
      <h1 class="font-bebas text-[clamp(52px,8vw,96px)] leading-[0.9] tracking-[3px] mb-6 max-md:text-[52px]">
        {t("section.title.services")}
      </h1>
      <p class="text-[15px] font-light text-gray-custom max-w-xl leading-relaxed">
        {t("section.sub.services")}
      </p>
    </div>
  </section>

  <!-- Filter + Projects -->
  <ServicesPortfolio client:load lang="en" initialFilter={filtro} key={"sp-" + (filtro || "all")} />

  <!-- CTA strip -->
  <section class="px-12 py-16 bg-dark-2 border-t border-cyan/10 max-md:px-5 max-md:py-12">
    <div class="max-w-6xl mx-auto flex items-center justify-between gap-6 max-md:flex-col max-md:text-center">
      <div>
        <div class="font-bebas text-[clamp(28px,4vw,40px)] tracking-[2px] leading-tight">GOT A PROJECT IN MIND?</div>
        <div class="text-[13px] font-light text-gray-custom mt-1">First consultation is free, no strings attached.</div>
      </div>
      <a
        href="/en/contact"
        class="bg-cyan text-dark px-10 py-[14px] text-[12px] font-semibold tracking-[2px] uppercase no-underline inline-block hover:opacity-85 transition-opacity flex-shrink-0"
      >
        Free quote →
      </a>
    </div>
  </section>
</Layout>
