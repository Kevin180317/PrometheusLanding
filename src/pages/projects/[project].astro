}

const { project } = Astro.props;

const buttonHref = project.category === "Web" ? project.projectUrl : "/contact";
const buttonText =
  project.category === "Web" ? "Ver Sitio Web" : "Solicitar Cotización";
const buttonIcon =
  project.category === "Web"
    ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>'
    : '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>';

const categoryColors: Record<"Web" | "App" | "Prototipo", string> = {
  Web: "bg-blue-100 text-blue-700",
  App: "bg-purple-100 text-purple-700",
  Prototipo: "bg-green-100 text-green-700",
};
---

<Layout
  title={`PrometheusTij || ${project.name}`}
  description={project.description}
  keywords="producto, servicios digitales, desarrollo web, desarrollo de apps, prototipos digitales, innovación tecnológica, soluciones personalizadas, impacto digital"
>
  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-4xl">
      <!-- Categoría y Año -->
      <div class="flex items-center gap-3 mb-6">
        <span
          class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${categoryColors[project.category as "Web" | "App" | "Prototipo"]}`}
        >
          {project.category}
        </span>
        {
          project.year && (
            <span class="text-gray-500 text-sm font-medium">
              {project.year}
            </span>
          )
        }
      </div>

      <!-- Título -->
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight"
      >
        {project.name}
      </h1>

      <!-- Descripción -->
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed mb-8">
        {project.description}
      </p>

      <!-- Tags -->
      {
        project.tags && (
          <div class="flex flex-wrap gap-2 mb-8">
            {project.tags.map((tag) => (
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <!-- CTA Button -->
      <a
        href={buttonHref}
        target={project.category === "Web" ? "_blank" : "_self"}
        rel={project.category === "Web" ? "noopener noreferrer" : ""}
        class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white px-8 py-4 rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all duration-300 font-semibold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
      >
        <span>{buttonText}</span>
        <span set:html={buttonIcon} />
      </a>
    </div>
  </section>

  <!-- Galería de Imágenes -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-3xl font-bold text-gray-900 mb-8">Galería del Proyecto</h2>

    <!-- Grid adaptativo con altura controlada -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        project.images.map((img, index) => (
          <div
            class="group relative overflow-hidden rounded-xl shadow-lg hover:shadow-2xl transition-all duration-500 bg-gray-50"
            style={`animation: fadeInUp 0.6s ease-out forwards; animation-delay: ${index * 0.1}s; opacity: 0;`}
          >
            <div class="w-full min-h-[300px] max-h-[600px] flex items-center justify-center p-4">
              <img
                src={img}
                alt={`${project.name} - Vista ${index + 1}`}
                class="max-w-full max-h-full w-auto h-auto object-contain transform group-hover:scale-105 transition-transform duration-700 rounded-3xl"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Sección de Características -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div
      class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-3xl p-8 sm:p-12"
    >
      <h2 class="text-3xl font-bold text-gray-900 mb-6">
        ¿Interesado en un proyecto similar?
      </h2>
      <p class="text-lg text-gray-600 mb-8 max-w-3xl">
        {
          project.category === "Web"
            ? "Creamos sitios web modernos, rápidos y optimizados para conversión. Cada proyecto está diseñado para destacar tu marca y alcanzar tus objetivos de negocio."
            : project.category === "App"
              ? "Desarrollamos aplicaciones móviles intuitivas y robustas que tus usuarios amarán. Desde la idea hasta la publicación en las tiendas."
              : "Transformamos ideas en prototipos tangibles y modelos 3D de alta calidad. Visualiza tu proyecto antes de llevarlo a producción."
        }
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-gray-900 text-white px-8 py-4 rounded-xl hover:bg-gray-800 transition-colors font-semibold shadow-lg"
        >
          <span>Iniciar un Proyecto</span>
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/product"
          class="inline-flex items-center justify-center gap-2 bg-white text-gray-900 px-8 py-4 rounded-xl hover:bg-gray-50 transition-colors font-semibold shadow-lg border-2 border-gray-200"
        >
          <span>Ver Más Proyectos</span>
        </a>
      </div>
    </div>
  </section>

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Layout>
