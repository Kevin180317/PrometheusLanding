      description:
        "Aplicación de recetas con búsqueda avanzada, favoritos, y modo de cocina paso a paso. Incluye conversión de medidas y lista de compras inteligente.",
      category: "App",
      tags: ["Cocina", "Mobile", "Lifestyle"],
      year: "2024",
      images: [
        "/Imagenes/app2.png",
        "/Imagenes/app2.2.png",
        "/Imagenes/app2.3.png",
      ],
      projectUrl: "/proyecto-3",
    },
