---
import Layout from "@Layouts/Layout.astro";
import Hero from "@Components/Hero.astro";
import Service from "@Components/Service.astro";
import About from "@Components/About.astro";
import Differentiators from "@Components/Differentiators.astro";
import Portfolio from "@Components/Portfolio.astro";
import Testimonials from "@Components/Testimonials.astro";
import Contact from "@Components/Contact";

import LanguageModal from "@Components/LanguageModal";

import { getLangFromUrl, useTranslations } from "@src/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="Prometheus R&D | Software, Apps & AI Automation — Tijuana"
  description="Prometheus R&D — Software, AI Automation & Digital Electronics. Empresa tijuanense con visión binacional Tijuana–San Diego."
  keywords="PrometheusTij, desarrollo web, desarrollo de apps, prototipos digitales, IA, automatización, Tijuana, San Diego, binacional"
>
  <LanguageModal client:load />
  <Hero />
  <Service />
  <About />
  <Differentiators />
  <Portfolio />
  <Testimonials />
  <Contact
    client:load
    eyebrow={t("contact.eyebrow")}
    title={t("contact.title")}
    labelPhone={t("contact.label.phone")}
    labelEmail={t("contact.label.email")}
    labelLocation={t("contact.label.location")}
    labelWebsite={t("contact.label.website")}
    whatsapp={t("contact.whatsapp")}
    placeholderName={t("contact.placeholder.name")}
    placeholderEmail={t("contact.placeholder.email")}
    placeholderCompany={t("contact.placeholder.company")}
    placeholderSubject={t("contact.placeholder.subject")}
    placeholderMessage={t("contact.placeholder.message")}
    buttonTextSubmit={t("contact.button.text")}
    buttonText={t("contact.button")}
    buttonSending={t("contact.button.sending")}
    buttonError1={t("contact.button.error1")}
    buttonError2={t("contact.button.error2")}
    buttonSuccess={t("contact.button.success")}
    recaptchaError={t("contact.recaptcha.error")}
  />
</Layout>
